# ============================================
# Academic Summary Pipeline - Configuration
# ============================================
# Copy this file to .env and fill in your tokens
# NEVER commit .env to git!

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API Key (from openrouter.ai/settings/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# API Configuration (api.b.ai)
API_BASE_URL=https://api.b.ai
API_MODEL=gpt-5.2

# GitHub Username (for GitHub Pages URL)
GITHUB_USERNAME=your_username
